FROM tomcat:10.1-jdk21-temurin@sha256:07191205c229da87cb8cbb086c12f513601846147fcccf2d79aff945f627e9a9
RUN rm -rf /usr/local/tomcat/webapps/* && mkdir -p /app/data/uploads
RUN sed -i 's/port="8080"/port="8080" useVirtualThreads="true" maxConnections="4096" acceptCount="256"/' /usr/local/tomcat/conf/server.xml
WORKDIR /app
COPY target/activity-assistant-2.0.0.war /usr/local/tomcat/webapps/ROOT.war
