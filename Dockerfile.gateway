FROM node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914
WORKDIR /app
COPY qq-gateway/package*.json ./
RUN npm ci --omit=dev
COPY qq-gateway/server.mjs qq-gateway/delivery-cache.mjs qq-gateway/persistent-delivery.mjs qq-gateway/gateway-http.mjs ./
CMD ["node", "server.mjs"]
