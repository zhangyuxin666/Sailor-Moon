DOMAIN=class.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-password

LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=
QQ_GATEWAY_TOKEN=replace-with-a-long-random-token

TIMEZONE=Asia/Shanghai
SESSION_DAYS=7
UPLOAD_MAX_MB=20
USER_STORAGE_QUOTA_MB=200

# 推荐使用兼容 S3 的对象存储；暂时留空则使用 Docker 持久化卷
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=data/uploads
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
