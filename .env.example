# Shared internal authentication. Use a long random value outside local development.
AI_INTERNAL_TOKEN=change-this-local-ai-token
QQ_GATEWAY_TOKEN=change-this-local-token

# DeepSeek/OpenAI-compatible chat API. Empty key enables the deterministic offline fallback.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Optional OpenAI-compatible embedding endpoint. Without it, RAG uses a local hash embedding fallback.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Browser and application settings
PUBLIC_BASE_URL=http://127.0.0.1:8080
COOKIE_SECURE=false
SESSION_DAYS=7
TIMEZONE=Asia/Shanghai
UPLOAD_MAX_MB=20
USER_STORAGE_QUOTA_MB=200
STORAGE_LOCAL_PATH=data/uploads
APP_PORT=8080

# QQ Open Platform. Spring automatically enables the integration when both values exist.
QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=

# Used by local migration scripts. Compose injects service-specific database URLs itself.
DATABASE_URL=postgresql://activity:activity@127.0.0.1:55432/activity
