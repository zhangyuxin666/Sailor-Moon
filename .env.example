# LLM（OpenAI 兼容接口）。不配置 LLM_API_KEY 时自动使用离线 Mock，全流程仍可跑通
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 本地用 SQLite；部署改为 postgresql+psycopg://activity:password@postgres:5432/activity
DATABASE_URL=sqlite:///activity.db
WORKER_POLL_SECONDS=1
WORKER_MAX_ATTEMPTS=3

# 定时任务时区
TIMEZONE=Asia/Shanghai

# QQ 开放平台官方机器人：https://q.qq.com/
QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=
QQ_GATEWAY_TOKEN=change-this-local-token

# 报名链接的外部可访问地址。局域网演示可填电脑局域网 IP，公网部署填 HTTPS 域名。
PUBLIC_BASE_URL=http://127.0.0.1:8001

# 生产环境设为 production，并通过 HTTPS 使用安全 Cookie
ENVIRONMENT=development
COOKIE_SECURE=false
SESSION_DAYS=7

# 文件存储。公开部署建议改为 s3，并配置兼容 S3 的对象存储
UPLOAD_MAX_MB=20
USER_STORAGE_QUOTA_MB=200
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=data/uploads
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
ALLOW_LEGACY_API=false
